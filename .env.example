# Copy to ".env" and fill in.

# --- Reasoning LLM (Gemini free tier) ---
# Free key: https://aistudio.google.com/apikey  (same one your Telegram bot uses)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Market data (US stocks) ---
# Free key: https://twelvedata.com  — optional; crypto works without it.
TWELVE_DATA_API_KEY=

# --- Fundamentals (optional) ---
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- Evaluation judge (optional, but the only way to grade independently) ---
# With neither key set, the judge falls back to a different Gemini model. That shares a
# model family with the agent, so it shares its blind spots, and the evaluation report
# says as much. It also shares the free tier's limits: 5 requests a minute, 20 a day, and
# 503 "high demand" refusals when the model is busy.
# Setting either key switches the judge automatically — no code change.
#   pip install langchain-anthropic   (or langchain-openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agent behaviour ---
MAX_SUBQUESTIONS=5           # how many sub-questions the planner may produce
MAX_CRITIC_LOOPS=2           # how many times the critic can send research back
