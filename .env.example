# Copy to ".env" and fill in.

# --- Reasoning LLM (Gemini free tier) ---
# Free key: https://aistudio.google.com/apikey  (same one your Telegram bot uses)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Market data (US stocks) ---
# Free key: https://twelvedata.com  — optional; crypto works without it.
TWELVE_DATA_API_KEY=

# --- Fundamentals (optional) ---
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- Agent behaviour ---
MAX_SUBQUESTIONS=5           # how many sub-questions the planner may produce
MAX_CRITIC_LOOPS=2           # how many times the critic can send research back
